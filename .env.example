# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/mastersolis
MONGODB_URI=mongodb://localhost:27017/mastersolis

# JWT Secret (use a strong random string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Google Gemini AI
# Get from: https://makersuite.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudinary (for file uploads)
# Sign up at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Configuration (Gmail)
# Use app-specific password: https://myaccount.google.com/apppasswords
EMAIL_SERVICE=gmail
EMAIL_USER=mastersolis.hr@gmail.com
EMAIL_PASS=your_app_specific_password

# Testmail.app (for development email testing)
# Sign up at: https://testmail.app
TESTMAIL_API_KEY=your_testmail_api_key
TESTMAIL_NAMESPACE=mastersolis

# Frontend URLs
# Development
CLIENT_URL=http://localhost:5173

# Production
PRODUCTION_URL=https://hackthon-cicada.onrender.com

# Optional: Database backups
# BACKUP_ENABLED=true
# BACKUP_FREQUENCY=daily

# Optional: Analytics
# ANALYTICS_ENABLED=true
# SENTRY_DSN=your_sentry_dsn_for_error_tracking
